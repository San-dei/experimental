# Configurá estas dos variables en Vercel para habilitar el guardado del formulario.
# URL del proyecto (no la URL del panel de administración).
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave Secret de Supabase, exclusiva del servidor.
# Nunca uses el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SECRET_KEY=sb_secret_reemplazar

# Opcional: dirección pública de la web para sus metadatos.
# Si se omite en Vercel, se toma VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app
